<Window x:Class="tinyEditor.ConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Debug Console" Width="720" Height="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- Search box spans command-list column -->
        <TextBox x:Name="searchBox" Grid.Row="0" Grid.Column="0" Margin="0,0,6,6"
                 TextChanged="OnSearchChanged"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Margin="6,0,0,6"
                   FontWeight="Bold" VerticalAlignment="Center" Text="Parameters"/>

        <!-- Command tree (dotted-namespace grouping) -->
        <TreeView x:Name="commandTree" Grid.Row="1" Grid.Column="0" Margin="0,0,6,0"
                  SelectedItemChanged="OnCommandSelected"/>

        <!-- Parameter panel (built dynamically) + Run button -->
        <DockPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,0">
            <Button x:Name="runButton" DockPanel.Dock="Bottom" Content="Run"
                    Padding="12,4" Margin="0,6,0,0" Click="OnRun" IsEnabled="False"/>
            <TextBlock x:Name="helpText" DockPanel.Dock="Top" TextWrapping="Wrap"
                       Foreground="Gray" Margin="0,0,0,6"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="paramPanel"/>
            </ScrollViewer>
        </DockPanel>

        <!-- Output log -->
        <ListBox x:Name="outputList" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                 Margin="0,8,0,0" FontFamily="Consolas" FontSize="12"/>
    </Grid>
</Window>
