<Window x:Class="tinyEditor.RenderDocPathDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RenderDoc UI Path" Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="12">
        <TextBlock Text="Path to qrenderdoc.exe (used to open captures):"
                   Margin="0,0,0,6"/>
        <DockPanel Margin="0,0,0,4">
            <Button Content="Browse..." DockPanel.Dock="Right"
                    Padding="12,2" Margin="6,0,0,0" Click="OnBrowse"/>
            <TextBox x:Name="pathBox" TextChanged="OnPathChanged"/>
        </DockPanel>
        <TextBlock x:Name="statusText" Margin="0,0,0,10"
                   TextWrapping="Wrap" FontStyle="Italic" Foreground="Gray"/>
        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11"
                   Text="Tip: leave empty to fall back to RenderDoc's own launcher (which needs the UI to sit next to the loaded renderdoc.dll)."/>
        <DockPanel Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Cancel" Width="80"
                    Padding="0,3" Margin="6,0,0,0" IsCancel="True"/>
            <Button DockPanel.Dock="Right" Content="OK" Width="80"
                    Padding="0,3" IsDefault="True" Click="OnOk"/>
            <TextBlock/>
        </DockPanel>
    </StackPanel>
</Window>
