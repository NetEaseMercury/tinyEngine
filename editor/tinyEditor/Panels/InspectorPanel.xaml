<UserControl x:Class="tinyEditor.Panels.InspectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="6">
            <TextBlock Text="Inspector" FontWeight="Bold" FontSize="14" Margin="2,2,2,6"/>
            <TextBlock x:Name="selectedLabel" Text="Selected: None" Margin="2,0,2,8" TextWrapping="Wrap"/>

            <TextBlock Text="Transform" FontWeight="SemiBold"/>
            <StackPanel x:Name="transformSection" Margin="2,4" Visibility="Collapsed">
                <TextBlock Text="Position"/>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="X" VerticalAlignment="Center"/>
                    <TextBox x:Name="posX" Width="62" Margin="2,0,8,0"/>
                    <TextBlock Text="Y" VerticalAlignment="Center"/>
                    <TextBox x:Name="posY" Width="62" Margin="2,0,8,0"/>
                    <TextBlock Text="Z" VerticalAlignment="Center"/>
                    <TextBox x:Name="posZ" Width="62" Margin="2,0,0,0"/>
                </StackPanel>
                <Button Content="Apply Position" Click="OnApplyPosition" Margin="0,6,0,2" Padding="12,2"
                        HorizontalAlignment="Left"/>
            </StackPanel>

            <Separator Margin="0,8"/>

            <TextBlock Text="Material" FontWeight="SemiBold"/>
            <ComboBox x:Name="materialCombo" Margin="2,4" SelectionChanged="OnMaterialComboChanged"/>
            <Button Content="Assign to Selected" Click="OnAssign" Margin="2,2" Padding="12,2"
                    HorizontalAlignment="Left"/>

            <StackPanel x:Name="paramsSection" Margin="2,6,2,2" Visibility="Collapsed">
                <TextBlock Text="Base Color" FontWeight="SemiBold"/>
                <TextBlock Text="R"/>
                <Slider x:Name="baseR" Minimum="0" Maximum="1" ValueChanged="OnParamsChanged"/>
                <TextBlock Text="G"/>
                <Slider x:Name="baseG" Minimum="0" Maximum="1" ValueChanged="OnParamsChanged"/>
                <TextBlock Text="B"/>
                <Slider x:Name="baseB" Minimum="0" Maximum="1" ValueChanged="OnParamsChanged"/>

                <TextBlock Text="Roughness" FontWeight="SemiBold" Margin="0,6,0,0"/>
                <Slider x:Name="roughness" Minimum="0" Maximum="1" ValueChanged="OnParamsChanged"/>
                <TextBlock Text="Metallic" FontWeight="SemiBold"/>
                <Slider x:Name="metallic" Minimum="0" Maximum="1" ValueChanged="OnParamsChanged"/>

                <TextBlock Text="Emissive Intensity" FontWeight="SemiBold" Margin="0,6,0,0"/>
                <Slider x:Name="emissiveIntensity" Minimum="0" Maximum="20" ValueChanged="OnParamsChanged"/>
                <TextBlock Text="Emissive Color R"/>
                <Slider x:Name="emissiveR" Minimum="0" Maximum="1" ValueChanged="OnParamsChanged"/>
                <TextBlock Text="Emissive Color G"/>
                <Slider x:Name="emissiveG" Minimum="0" Maximum="1" ValueChanged="OnParamsChanged"/>
                <TextBlock Text="Emissive Color B"/>
                <Slider x:Name="emissiveB" Minimum="0" Maximum="1" ValueChanged="OnParamsChanged"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
