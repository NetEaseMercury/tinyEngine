<UserControl x:Class="tinyEditor.Panels.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="2,2,2,6">
            <TextBlock Text="Log" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
            <Button Content="Clear" Click="OnClear" DockPanel.Dock="Right" Padding="12,2"/>
        </DockPanel>

        <ListBox x:Name="logList" Grid.Row="1" Margin="2" FontFamily="Consolas" FontSize="12"/>
    </Grid>
</UserControl>
