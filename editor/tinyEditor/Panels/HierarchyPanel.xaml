<UserControl x:Class="tinyEditor.Panels.HierarchyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Hierarchy" FontWeight="Bold" FontSize="14" Margin="2,2,2,6"/>

        <ListBox x:Name="entityList" Grid.Row="1" Margin="2"
                 SelectionChanged="OnSelectionChanged"/>

        <StackPanel Grid.Row="2" Margin="2,8,2,2">
            <TextBlock Text="Add Box" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="X" VerticalAlignment="Center"/>
                <TextBox x:Name="boxX" Width="56" Text="0" Margin="2,0,8,0"/>
                <TextBlock Text="Y" VerticalAlignment="Center"/>
                <TextBox x:Name="boxY" Width="56" Text="0" Margin="2,0,8,0"/>
                <TextBlock Text="Z" VerticalAlignment="Center"/>
                <TextBox x:Name="boxZ" Width="56" Text="0" Margin="2,0,0,0"/>
            </StackPanel>
            <Button Content="Add Box" Click="OnAddBox" Margin="0,6,0,2" Padding="12,2"/>
            <Button Content="Delete Selected Box" Click="OnDeleteBox" Padding="12,2"/>
        </StackPanel>
    </Grid>
</UserControl>
