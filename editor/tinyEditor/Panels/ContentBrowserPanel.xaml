<UserControl x:Class="tinyEditor.Panels.ContentBrowserPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="2,2,2,6">
            <TextBlock Text="Content Browser (res/materials)" FontWeight="Bold" FontSize="14"
                       VerticalAlignment="Center"/>
            <Button Content="Refresh" Click="OnRefresh" DockPanel.Dock="Right" Padding="12,2"/>
        </DockPanel>

        <ListBox x:Name="astList" Grid.Row="1" Margin="2"
                 MouseDoubleClick="OnDoubleClick"/>
    </Grid>
</UserControl>
